#!/usr/bin/env bash
# PicoSeek — 医学文献问答 demo 统一入口
#
#   ./PicoSeek start [14b|4b] [GPU]   在 tmux 会话 "PicoSeek" 里启动 vLLM + LiteLLM（默认 Qwen3-14B, GPU 2）
#   ./PicoSeek stop                   停止全部服务
#   ./PicoSeek status                 查看 tmux / vLLM / LiteLLM / GPU 状态
#   ./PicoSeek ask "问题" [--papers N] [--years 3 | --year 2018-2024] [--quartile Q1,Q2] [--journal Nature,Lancet] [--no-paywall] [--no-kb]
#                                一键流水线：检索(可按年份/分区/期刊筛选) → 下载全文 → 逐篇阅读 → 带段落定位引用的答案（answers/<ts>.md）
#   ./PicoSeek kb search "关键词" [--top N] [--kind fact|paragraph]
#                                检索本地知识库（历次阅读抽取的原子知识 + 原文段落，向量检索）
#   ./PicoSeek kb stats | reindex   知识库统计 / 重建索引
#   ./PicoSeek rank download [YEAR] 下载 SCImago 期刊分区表到 data/journal_ranks/（headless 浏览器过 Cloudflare）
#   ./PicoSeek rank lookup "ISSN或刊名"  查询某期刊分区
#   ./PicoSeek rank stats           已加载的分区表与索引规模
#   ./PicoSeek codex ["问题"]         Codex 交互式 agent（不带问题进入 TUI；带问题一次性回答）
#   ./PicoSeek paywall get DOI        用机构订阅登录态下载付费墙全文到 pdfs/
#   ./PicoSeek paywall login [--url URL]
#   ./PicoSeek logs                   打开 tmux 查看服务日志
#   ./PicoSeek verify                 核对最近一次 Codex 回答里的 PMID/DOI 是否来自工具返回
#   ./PicoSeek test                   不经过模型，直接测试文献检索工具
set -e
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV="${PICOSEEK_ENV:-$(cd "$ROOT/.." && pwd)/.venv}"   # 默认用仓库根 uv workspace 的 .venv；可用 PICOSEEK_ENV 指向其他环境
PY="$ENV/bin/python"
[ -x "$PY" ] || { echo "找不到 Python 环境: $PY"; echo "在仓库根执行 uv sync --all-packages 创建，或设 PICOSEEK_ENV=<环境目录>"; exit 1; }
export PATH="$HOME/.local/bin:$ENV/bin:$PATH"
export LOCAL_QWEN_KEY="${LOCAL_QWEN_KEY:-sk-123456}"   # 需与 litellm_config.yaml 的 master_key 一致
# export S2_API_KEY=""                                 # 可选：Semantic Scholar key
cd "$ROOT"

usage() { sed -n '2,/^set -e/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }
services_up() { curl -s -m 3 -H "Authorization: Bearer $LOCAL_QWEN_KEY" http://127.0.0.1:4000/v1/models >/dev/null; }
require_services() {
  services_up || { echo "LiteLLM/vLLM 未运行。先执行: ./PicoSeek start   （然后 ./PicoSeek status 等待就绪）"; exit 1; }
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  start)
    SIZE="${1:-14b}"; GPU="${2:-2}"
    if tmux has-session -t PicoSeek 2>/dev/null; then echo "tmux 会话 'PicoSeek' 已在运行（./PicoSeek logs 查看）"; exit 0; fi
    tmux new-session  -d -s PicoSeek -n vllm    "bash $ROOT/scripts/vllm.sh $SIZE $GPU; echo VLLM EXITED; sleep 999999"
    tmux new-window   -d -t PicoSeek -n litellm "sleep 15; bash $ROOT/scripts/litellm.sh; echo LITELLM EXITED; sleep 999999"
    echo "已在 tmux 会话 'PicoSeek' 中启动（$SIZE, GPU $GPU）。vLLM 加载模型需 1–3 分钟。"
    echo "查看状态: ./PicoSeek status     查看日志: ./PicoSeek logs"
    ;;
  stop)
    tmux kill-session -t PicoSeek 2>/dev/null && echo "已停止 tmux 会话 PicoSeek"
    pkill -f "vllm serve" 2>/dev/null || true; pkill -f "litellm --config" 2>/dev/null || true
    echo "done"
    ;;
  status)
    echo "--- tmux ---";          tmux list-windows -t PicoSeek 2>&1 || true
    echo "--- vLLM    :8000 ---"; curl -s -m 3 http://127.0.0.1:8000/v1/models | python3 -c "import sys,json;print([m['id'] for m in json.load(sys.stdin)['data']])" 2>/dev/null || echo "not ready"
    echo "--- LiteLLM :4000 ---"; curl -s -m 3 -H "Authorization: Bearer $LOCAL_QWEN_KEY" http://127.0.0.1:4000/v1/models | python3 -c "import sys,json;print([m['id'] for m in json.load(sys.stdin)['data']])" 2>/dev/null || echo "not ready"
    echo "--- GPU ---";           nvidia-smi --query-gpu=index,memory.used,memory.total --format=csv,noheader 2>/dev/null || echo "无 NVIDIA GPU（vLLM 不可用；kb 子命令不需要）"
    ;;
  logs)    exec tmux attach -t PicoSeek ;;
  ask)
    [ $# -gt 0 ] || { echo "用法: ./PicoSeek ask \"问题\" [--papers N] [--years 3|--year 2018-2024] [--quartile Q1,Q2] [--journal Nature] [--keep-unranked] [--no-paywall] [--no-kb]"; exit 1; }
    require_services
    exec "$PY" ask.py "$@"
    ;;
  codex)
    require_services
    if [ $# -gt 0 ]; then
      mkdir -p answers
      OUT="answers/$(date +%Y%m%d_%H%M%S).md"
      { echo "# Q: $*"; echo; } > "$OUT"
      codex exec --skip-git-repo-check --output-last-message "$OUT.tmp" "$*" < /dev/null
      sed 's/<think>.*<\/think>//' "$OUT.tmp" 2>/dev/null | awk 'BEGIN{skip=0} /<think>/{skip=1} /<\/think>/{skip=0; next} !skip' >> "$OUT"
      rm -f "$OUT.tmp"
      echo; echo "答案已保存: $ROOT/$OUT"
    else
      exec codex
    fi
    ;;
  paywall) exec "$PY" paywall_fetch.py "$@" ;;
  kb)      exec "$PY" knowledge_store.py "$@" ;;
  rank)    exec "$PY" journal_rank.py "$@" ;;
  verify)  exec "$PY" verify_citations.py "$@" ;;
  test)    exec "$PY" test_mcp.py "$@" ;;
  help|-h|--help) usage ;;
  *) echo "未知命令: $cmd"; echo; usage; exit 1 ;;
esac
