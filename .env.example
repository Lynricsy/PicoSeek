# 宿主机映射的 API 端口（本机 8000 已被占用，默认 8765）
PICOSEEK_PORT=8765

# 用户登录会话固定有效期（秒）；首次管理员通过 picoseek create-admin 创建
PICOSEEK_SESSION_TTL_S=604800
PICOSEEK_LOGIN_MAX_ATTEMPTS=10
PICOSEEK_LOGIN_WINDOW_S=300
PICOSEEK_MAX_ACTIVE_JOBS_PER_USER=2

# LLM 网关（compose 里默认指向宿主机 LiteLLM :4000）
LLM_BASE=http://host.docker.internal:4000/v1
LLM_MODEL=qwen3-14b
LOCAL_QWEN_KEY=sk-123456

# 可选：上游文献 API 配额
NCBI_API_KEY=
S2_API_KEY=

# 向量编码（bge-m3, CPU）。EMBED_THREADS 必须按机器标定一次，容器/虚拟机里读不到
# 真实拓扑，代码不做推断：留空就沿用 torch 默认（= 逻辑核数），实测往往是最差的一档。
# 标定脚本见 core/README.md「6.2 编码吞吐标定」——换机器必须重跑一次。
# 参考：24 vCPU 的 KVM guest（宿主 7950X3D）最优 12（156 ms/条），
# 而 torch 默认的 24 线程是 420 ms/条，差 2.7 倍。
EMBED_THREADS=12
# 单批 padding 后的 token 上限。只有 EMBED_THREADS 调对后才显效（1.04× → 2.24×）。
EMBED_BATCH_TOKENS=1024
# torch（默认）或 onnx。onnx 需手动安装 optimum 并导出 int8 权重（见 core/README.md「6.3」），
# 快约 2.2×，但向量会变（cos_min 0.937 / top-5 邻居重合 0.875），换了必须 reindex。
EMBED_BACKEND=torch

# 前端（nginx）宿主机端口
PICOSEEK_WEB_PORT=39109
